            "url": "https://api.chargedesk.com/v1/gateway/products/charge",
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "using",
                  "value": ""
                },
                {
                  "name": "customer[id]",
                  "value": ""
                },
                {
                  "name": "amount",
                  "value": ""
                },
                {
                  "name": "currency",
                  "value": ""
                },
                {
                  "name": "description",
                  "value": ""
                },
                {
                  "name": "product[interval]",
                  "value": ""
                },
                {
                  "name": "product[interval_count]",
                  "value": ""
                },
                {
                  "name": "product[trial_period_days]",
                  "value": ""
                },
                {
                  "name": "product[billing_cycles_total]",
                  "value": ""
                },
                {
                  "name": "contact",
                  "value": ""
                },
                {
                  "name": "link_only",
                  "value": ""
                },
                {
                  "name": "lines[]",
                  "value": ""
                },
                {
                  "name": "metadata[key]",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Create a live charge, subscription, or payment request via gateway"
        },
        {
          "info": {
            "name": "Refund a charge via gateway",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.chargedesk.com/v1/gateway/charges/:charge_id/refund",
            "params": [
              {
                "name": "charge_id",
                "value": "",
                "type": "path",
                "description": "Unique charge identifier"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "amount",
                  "value": ""
                },
                {
                  "name": "log_reason",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Refund a charge via gateway"
        },
        {
          "info": {
            "name": "Capture an authorized charge via gateway",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.chargedesk.com/v1/gateway/charges/:charge_id/capture",
            "params": [
              {
                "name": "charge_id",
                "value": "",
