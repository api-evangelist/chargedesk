                "description": "Unique charge identifier"
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": [
                {
                  "name": "amount",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Capture an authorized charge via gateway"
        },
        {
          "info": {
            "name": "Cancel a payment request (void)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.chargedesk.com/v1/gateway/charges/:charge_id/void",
            "params": [
